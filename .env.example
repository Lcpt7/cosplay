# ================================================================
# 本地开发环境变量（复制此文件为 .env.local 并填入真实值）
# ================================================================
# 这些变量仅在 Vite dev proxy 层使用，不会被打包进前端产物。

# SillyTavern Basic Auth 凭据
ST_BASIC_USER=your_username
ST_BASIC_PASS=your_password

# SillyTavern 服务器地址（可选，有默认值）
ST_BACKEND_URL=http://8.217.107.14:8000

# ================================================================
# Cloudflare Pages 环境变量（在 Dashboard → Settings → Environment variables 配置）
# ================================================================
# 不要在此文件填写真实值！在 Cloudflare Dashboard 中设置为 Secrets。
#
# ST_BASIC_USER   — SillyTavern Basic Auth 用户名（Secret）
# ST_BASIC_PASS   — SillyTavern Basic Auth 密码（Secret）
# ST_BACKEND_URL  — SillyTavern 服务器地址（普通变量，非敏感）